# 로컬 테스트 전용입니다. 실제 개인 값은 .env에만 두고 커밋하지 않습니다.
NODE_ENV=development
PORT=3000
ENABLE_DEV_LEARNING_DATA=true
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# 아래 세 계정의 기본값은 동봉한 로컬 DB 초기 SQL/Compose와 맞춘 공개 테스트 값입니다.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=leren
DB_USER=app_user
DB_PASSWORD=app_local
DB_MIGRATION_USER=migrator
DB_MIGRATION_PASSWORD=migrator_local

# setup:local이 각 PC에서 서로 다른 난수로 생성합니다. 외부 서비스에서 발급받는 키가 아닙니다.
JWT_ACCESS_SECRET=replace-with-local-access-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# 현재 화면/임시 학습 테스트는 AI 서버를 호출하지 않습니다. 실제 AI 연동은 별도 작업입니다.
FASTAPI_BASE_URL=http://127.0.0.1:8000
FASTAPI_INTERNAL_TOKEN=
