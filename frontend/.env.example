# PC 웹 localhost:3001에서 로컬 백엔드를 사용합니다. 끝에 /api/v1이나 /api-docs를 붙이지 않습니다.
# 카카오 앱 키·Client Secret·DB/JWT 비밀 값은 백엔드의 비공개 설정에만 넣습니다.
# 휴대폰의 localhost는 PC를 가리키지 않습니다. 이번 카카오 흐름은 PC 웹 테스트용입니다.
# EXPO_PUBLIC_ 값은 앱에 공개됩니다. 비밀번호·JWT·API 키를 넣지 않습니다.
EXPO_PUBLIC_API_URL=http://localhost:3000
# 최신 test에 있던 학습 JSON 로더용 주소는 인증 서버와 별개로 유지합니다.
# main 기반 카카오 백엔드에는 /api/v1/dev-learning/catalog가 없으므로, 기존 테스트 학습 서버를 준비한 경우에만 지정합니다.
EXPO_PUBLIC_LEARNING_API_URL=
