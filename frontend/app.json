{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.leren.frontend.dev",
      "supportsTablet": true
    },
    "android": {
      "package": "com.leren.frontend.dev",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      "./plugins/withAndroidShortObjectPaths"
    ],
    "scheme": "leren",
    "extra": {
      "eas": {
        "projectId": "2970762f-27a0-4c86-8d3a-2f79cdda6e5b"
      }
    },
    "owner": "leren"
  }
}
